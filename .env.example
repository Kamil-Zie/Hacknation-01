# Dev: apps run locally, database is the shared MongoDB Atlas cluster "hacknation" (database "hacknation").
# Copy to .env and paste the MONGODB_URI you got from Kamil. Never commit .env.
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@hacknation.<id>.mongodb.net/hacknation?retryWrites=true&w=majority
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
