# Dev: apps run locally, database is the shared MongoDB Atlas cluster "hacknation" (database "hacknation").
# Copy to .env and paste the MONGODB_URI you got from Kamil. Never commit .env.
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@hacknation.<id>.mongodb.net/hacknation?retryWrites=true&w=majority
# Database name is set explicitly (an URI without "/hacknation" would otherwise land in "test"). Prod: hacknation_prod.
MONGODB_DB=hacknation
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
# true = frontend on mocks from contracts/api.json examples, no backend needed
VITE_USE_MOCKS=false

# EUMETSAT Data Store (ADR-006, sourceId "eumetsat": H SAF ASCAT soil moisture).
# Free account: https://eoportal.eumetsat.int -> API key page: https://api.eumetsat.int/api-key
# Backend only (never VITE_*). Empty = source reported as "brak danych", analysis still works.
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
EUMETSAT_TOKEN_URL=https://api.eumetsat.int/token
EUMETSAT_API_URL=https://api.eumetsat.int/data
EUMETSAT_TIMEOUT_MS=15000

# Other sources need no keys (ADR-006). Timeouts per source in ms, total budget for POST /analyses.
ANALYSIS_BUDGET_MS=25000
# Overpass mirror used when the main instance is slow or rate-limited.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter

# Accounts (ADR-010). JWT_SECRET: required in prod (long random string, e.g. openssl rand -hex 32);
# empty in dev = random secret generated at process start (tokens reset on restart). Never commit a real value.
JWT_SECRET=
