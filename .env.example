# Dev: apps run locally, database is the shared MongoDB Atlas cluster (database hacknation_dev).
# Copy to .env and paste the MONGODB_URI you got from Kamil. Never commit .env.
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hacknation_dev?retryWrites=true&w=majority
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
