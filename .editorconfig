# Shared formatting for every editor (VS Code, WebStorm, Cursor...).
# Matches .prettierrc.json so the editor and Prettier never fight.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
max_line_length = off

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab

[{package-lock.json,*.min.*}]
insert_final_newline = unset
trim_trailing_whitespace = unset
max_line_length = off
