# T-065 Template of .env.prod for the backend on Synology. Copy to .env.prod on the NAS, fill in, chmod 600. NEVER commit .env.prod.
NODE_ENV=production
PORT=3000
# Atlas user with readWrite only on hacknation_prod; NAS public IP in Atlas -> Network Access
MONGODB_URI=<paste the Atlas connection string of the prod user here, database hacknation_prod>
MONGODB_DB=hacknation
# exactly this, no trailing slash
CORS_ORIGIN=https://app.kamil-zielinski.pl
# generate once: openssl rand -hex 32 (changing it logs everyone out)
JWT_SECRET=hacknation2026
