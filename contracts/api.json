{
  "owner_team": "backend",
  "version": "0.1.0",
  "base_url": "/api/v1",
  "endpoints": [
    {
      "id": "API-001",
      "status": "draft",
      "method": "GET",
      "path": "/items",
      "summary": "[PRZYKŁAD] Lista elementów z paginacją",
      "auth": "required",
      "request": {
        "query": {
          "page": "integer, domyślnie 1",
          "pageSize": "integer, domyślnie 20, maks. 100"
        }
      },
      "response": {
        "200": {
          "items": "Item[]",
          "total": "integer"
        }
      },
      "errors": [
        "401 UNAUTHORIZED",
        "422 VALIDATION_ERROR",
        "500 INTERNAL_SERVER_ERROR",
        "503 SERVICE_UNAVAILABLE",
        "504 GATEWAY_TIMEOUT",
        "429 TOO_MANY_REQUESTS",
        "400 BAD_REQUEST",
        "403 FORBIDDEN",
        "404 NOT_FOUND",
        "409 CONFLICT",
        "501 NOT_IMPLEMENTED"
      ],
      "data_refs": [
        "DM-001"
      ],
      "consumers": [
        "UI-S-001"
      ]
    }
  ]
}