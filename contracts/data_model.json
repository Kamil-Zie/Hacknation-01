{
  "owner_team": "backend",
  "version": "0.1.0",
  "_example": {
    "note": "Wzór formatu. Nie implementuj. id: DM-NNN, typy: string(n), integer, number, boolean, datetime, uuid/objectId, enum(a|b), Ref<DM-NNN>, T[].",
    "entity": {
      "id": "DM-001",
      "status": "draft",
      "name": "Item",
      "description": "Element listy",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "name",
          "type": "string(120)",
          "required": true
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true
        }
      ],
      "relations": [],
      "indexes": []
    }
  },
  "_note": "Kolekcje Mongo: tylko DM-001 (reports) i DM-002 (source_cache). DM-003..DM-005 to DTO i stałe z kodu (storage: dto/code), DM-006..DM-015 to obiekty osadzone w DM-001 (storage: embedded). Metodyka: docs/adr/ADR-007-methodology.md.",
  "entities": [
    {
      "id": "DM-001",
      "status": "proposed",
      "name": "Report",
      "storage": "collection: reports",
      "description": "Zapisany raport analizy działki na datę analizy; zwracany przez API-004 i API-005. Brak danych = null + wpis w dataGaps, nigdy wartość domyślna.",
      "fields": [
        { "name": "id", "type": "objectId", "required": true },
        {
          "name": "parcel",
          "type": "Ref<DM-003>",
          "required": true,
          "note": "kopia osadzona w chwili analizy"
        },
        { "name": "crop", "type": "object { code: string, name: string }", "required": true },
        { "name": "analysisDate", "type": "string(10) YYYY-MM-DD", "required": true },
        {
          "name": "status",
          "type": "enum(complete|partial)",
          "required": true,
          "note": "partial gdy choć jedno źródło ma status error|timeout|missing"
        },
        { "name": "assessment", "type": "Ref<DM-006>", "required": true },
        { "name": "vulnerability", "type": "Ref<DM-007>", "required": true },
        { "name": "causes", "type": "Ref<DM-008>[]", "required": true },
        {
          "name": "recommendations",
          "type": "Ref<DM-009>[]",
          "required": true,
          "note": "kolejność: retention_landscape, retention_soil, agrotechnics, irrigation; pusta, gdy ocena i podatność = unknown"
        },
        { "name": "sources", "type": "Ref<DM-011>[]", "required": true },
        { "name": "limitations", "type": "string[]", "required": true },
        { "name": "dataGaps", "type": "Ref<DM-012>[]", "required": true },
        {
          "name": "charts",
          "type": "object { kbw60Series: { date: string, kbwMm: number }[], kbw60Climatology: { date: string, p10: number, p50: number, p90: number }[] } | null",
          "required": false,
          "note": "should: wykres KBW sezonu na tle 10 lat (UI-C-011)"
        },
        {
          "name": "methodologyVersion",
          "type": "string(20)",
          "required": true,
          "note": "np. kropla-1.0"
        },
        { "name": "computedAt", "type": "datetime", "required": true },
        { "name": "durationMs", "type": "integer", "required": true },
        { "name": "createdAt", "type": "datetime", "required": true }
      ],
      "relations": [],
      "indexes": [
        { "fields": { "parcel.id": 1, "analysisDate": 1, "crop.code": 1 } },
        { "fields": { "createdAt": -1 } }
      ]
    },
    {
      "id": "DM-002",
      "status": "proposed",
      "name": "SourceCache",
      "storage": "collection: source_cache",
      "description": "Cache przetworzonych odpowiedzi źródeł (statystyki, nie rastry). Klucz: sourceId + parametry (zaokrąglony punkt/ID działki + zakres dat). TTL per źródło wg ADR-006.",
      "fields": [
        {
          "name": "key",
          "type": "string(200)",
          "required": true,
          "note": "np. meteo:52.4012,22.0410:2015-03-08:2025-05-20"
        },
        {
          "name": "sourceId",
          "type": "enum(uldk|meteo|sentinel2|eumetsat|soilgrids|elevation|overpass)",
          "required": true
        },
        {
          "name": "payload",
          "type": "Mixed",
          "required": true,
          "note": "znormalizowany wynik źródła; maks. ok. 200 kB na dokument"
        },
        { "name": "dataPeriod", "type": "string(40) | null", "required": false },
        { "name": "fetchedAt", "type": "datetime", "required": true },
        { "name": "expiresAt", "type": "datetime", "required": true }
      ],
      "relations": [],
      "indexes": [
        { "fields": { "key": 1 }, "unique": true },
        { "fields": { "expiresAt": 1 }, "expireAfterSeconds": 0 }
      ]
    },
    {
      "id": "DM-003",
      "status": "proposed",
      "name": "Parcel",
      "storage": "dto (z ULDK, cache w DM-002, kopia osadzona w DM-001)",
      "description": "Działka ewidencyjna z ULDK GUGiK, geometria GeoJSON EPSG:4326; powierzchnia i centroid liczone turf-em.",
      "fields": [
        {
          "name": "id",
          "type": "string(60)",
          "required": true,
          "note": "pełny TERYT, np. 141201_1.0001.123"
        },
        { "name": "parcelNumber", "type": "string(30)", "required": true },
        { "name": "region", "type": "string(120)", "required": true, "note": "obręb ewidencyjny" },
        { "name": "commune", "type": "string(120)", "required": true, "note": "gmina" },
        { "name": "county", "type": "string(120)", "required": true, "note": "powiat" },
        { "name": "voivodeship", "type": "string(60)", "required": true },
        { "name": "areaHa", "type": "number", "required": true },
        { "name": "centroid", "type": "object { lat: number, lon: number }", "required": true },
        { "name": "bbox", "type": "number[4] [minLon, minLat, maxLon, maxLat]", "required": true },
        { "name": "geometry", "type": "GeoJSON Polygon | MultiPolygon", "required": true },
        { "name": "source", "type": "string", "required": true, "note": "ULDK GUGiK" },
        { "name": "fetchedAt", "type": "datetime", "required": true }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-004",
      "status": "proposed",
      "name": "Crop",
      "storage": "code: apps/backend/src/services/engine/crops.ts",
      "description": "Uprawa z parametrami FAO-56 i oczekiwanymi zakresami NDVI/NDMI per miesiąc (tabela ADR-007 §2, §5).",
      "fields": [
        {
          "name": "code",
          "type": "enum(winter_wheat|spring_barley|maize|potato|winter_rapeseed|sugar_beet|grassland)",
          "required": true
        },
        { "name": "name", "type": "string(60)", "required": true },
        { "name": "kcIni", "type": "number", "required": true },
        { "name": "kcMid", "type": "number", "required": true },
        { "name": "kcEnd", "type": "number", "required": true },
        { "name": "rootDepthM", "type": "number", "required": true },
        {
          "name": "depletionFraction",
          "type": "number",
          "required": true,
          "note": "p z FAO-56 Tab. 22"
        },
        {
          "name": "stages",
          "type": "object { code: string, name: string, from: string MM-DD, to: string MM-DD, isCritical: boolean }[]",
          "required": true
        },
        {
          "name": "criticalPeriodLabel",
          "type": "string(80)",
          "required": true,
          "note": "np. strzelanie w źdźbło – kwitnienie (maj–czerwiec)"
        },
        {
          "name": "expectedIndices",
          "type": "object { month: integer, ndviMin: number, ndviMax: number, ndmiMin: number, ndmiMax: number }[]",
          "required": true
        },
        {
          "name": "reference",
          "type": "string",
          "required": true,
          "note": "FAO-56 Allen i in. 1998, Tab. 12 i 22"
        }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-005",
      "status": "proposed",
      "name": "DataSource",
      "storage": "code: apps/backend/src/services/sources/catalog.ts",
      "description": "Katalog źródeł danych (API-006, README sekcje 4–7).",
      "fields": [
        {
          "name": "id",
          "type": "enum(uldk|meteo|sentinel2|eumetsat|soilgrids|elevation|overpass)",
          "required": true
        },
        {
          "name": "name",
          "type": "string(80)",
          "required": true,
          "note": "np. Open-Meteo Historical (ERA5)"
        },
        {
          "name": "category",
          "type": "enum(spatial|meteo|satellite|soil|terrain|hydro)",
          "required": true
        },
        {
          "name": "label",
          "type": "string(40)",
          "required": true,
          "note": "prosta etykieta dla rolnika: Działka, Pogoda, Satelita (rośliny), Satelita (wilgotność gleby), Gleba, Teren, Woda w okolicy"
        },
        { "name": "provider", "type": "string(80)", "required": true },
        { "name": "url", "type": "string", "required": true },
        { "name": "license", "type": "string(80)", "required": true },
        {
          "name": "resolution",
          "type": "string(60)",
          "required": true,
          "note": "np. siatka 9–25 km"
        },
        { "name": "timeoutMs", "type": "integer", "required": true }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-006",
      "status": "proposed",
      "name": "Assessment",
      "storage": "embedded in DM-001",
      "description": "Ocena bieżąca na datę analizy (krok 4).",
      "fields": [
        { "name": "droughtClass", "type": "enum(none|moderate|severe|unknown)", "required": true },
        {
          "name": "droughtClassLabel",
          "type": "string(60)",
          "required": true,
          "note": "Brak suszy / Susza umiarkowana / Susza silna / Brak danych"
        },
        { "name": "isOutOfSeason", "type": "boolean", "required": true },
        { "name": "confidence", "type": "enum(high|medium|low)", "required": true },
        { "name": "confidenceScore", "type": "number 0–1", "required": true },
        { "name": "confidenceReasons", "type": "string[]", "required": true },
        {
          "name": "summary",
          "type": "string",
          "required": true,
          "note": "zdanie w prostym języku złożone z liczb (szablon w kodzie)"
        },
        { "name": "kbw30", "type": "Ref<DM-013> | null", "required": true },
        { "name": "kbw60", "type": "Ref<DM-013> | null", "required": true },
        {
          "name": "soilWater",
          "type": "object { tawMm: number, rawMm: number, depletionMm: number | null, isStressed: boolean | null } | null",
          "required": true,
          "note": "null gdy brak gleby"
        },
        {
          "name": "cropStage",
          "type": "object { code: string, name: string, kc: number, isCritical: boolean }",
          "required": true
        },
        { "name": "satellite", "type": "Ref<DM-014> | null", "required": true },
        {
          "name": "soilMoistureSatellite",
          "type": "Ref<DM-015> | null",
          "required": true,
          "note": "ASCAT SSM z EUMETSAT; null + wpis w dataGaps (sourceId eumetsat), gdy brak klucza, granuli lub timeout; tylko wpływ na pewność (ADR-007 §5a)"
        },
        { "name": "evidence", "type": "Ref<DM-010>[]", "required": true }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-007",
      "status": "proposed",
      "name": "Vulnerability",
      "storage": "embedded in DM-001",
      "description": "Podatność wieloletnia z 10 sezonów przed rokiem analizy (krok 5).",
      "fields": [
        { "name": "vulnerabilityClass", "type": "enum(low|medium|high|unknown)", "required": true },
        { "name": "vulnerabilityLabel", "type": "string(60)", "required": true },
        { "name": "yearsAnalyzed", "type": "integer", "required": true },
        { "name": "seasonsWithDeficit", "type": "integer | null", "required": true },
        { "name": "deficitYears", "type": "integer[]", "required": true },
        { "name": "criticalMonths", "type": "integer[] (1–12)", "required": true },
        {
          "name": "criticalMonthsLabel",
          "type": "string(40) | null",
          "required": true,
          "note": "np. maj–lipiec"
        },
        {
          "name": "monthly",
          "type": "object { month: integer, deficitFrequency: number, medianKbwMm: number }[]",
          "required": true,
          "note": "IV–IX"
        },
        {
          "name": "soil",
          "type": "object { sandPct: number, siltPct: number, clayPct: number, socPct: number, category: enum(very_light|light|medium|heavy), categoryLabel: string } | null",
          "required": true
        },
        { "name": "summary", "type": "string", "required": true },
        { "name": "evidence", "type": "Ref<DM-010>[]", "required": true }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-008",
      "status": "proposed",
      "name": "Cause",
      "storage": "embedded in DM-001",
      "description": "Przyczyna niedoboru wody wykryta regułą (ADR-007 §8).",
      "fields": [
        {
          "name": "code",
          "type": "enum(precip_deficit_heat|low_soil_retention|surface_runoff|crop_water_demand|low_vegetation_moisture)",
          "required": true
        },
        { "name": "title", "type": "string(80)", "required": true },
        {
          "name": "description",
          "type": "string",
          "required": true,
          "note": "prosty język z liczbami, np. Gleba ma 82% piasku i zatrzymuje tylko 48 mm wody w strefie korzeni"
        },
        { "name": "severity", "type": "enum(low|medium|high)", "required": true },
        { "name": "evidence", "type": "Ref<DM-010>[]", "required": true }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-009",
      "status": "proposed",
      "name": "Recommendation",
      "storage": "embedded in DM-001",
      "description": "Rekomendacja policzona regułą R-* (ADR-007 §9); zawsze z uzasadnieniem w danych.",
      "fields": [
        { "name": "ruleId", "type": "string(12)", "required": true, "note": "np. R-LAND-01" },
        {
          "name": "category",
          "type": "enum(retention_landscape|retention_soil|agrotechnics|irrigation)",
          "required": true
        },
        { "name": "order", "type": "integer", "required": true },
        { "name": "priority", "type": "enum(high|medium|low)", "required": true },
        { "name": "title", "type": "string(100)", "required": true },
        { "name": "action", "type": "string", "required": true, "note": "co zrobić" },
        {
          "name": "where",
          "type": "string | null",
          "required": true,
          "note": "np. wzdłuż południowej granicy działki (w dół spadku)"
        },
        { "name": "when", "type": "string | null", "required": true },
        { "name": "why", "type": "string", "required": true, "note": "uzasadnienie z liczbami" },
        {
          "name": "location",
          "type": "object { lat: number, lon: number } | null",
          "required": true,
          "note": "punkt na mapie (should)"
        },
        {
          "name": "irrigation",
          "type": "object { isJustified: boolean, netDoseMm: number | null, grossDoseMm: number | null, doseM3PerHa: number | null, window: string | null, nextCheckInDays: number | null } | null",
          "required": true,
          "note": "tylko dla category=irrigation"
        },
        { "name": "evidence", "type": "Ref<DM-010>[]", "required": true, "note": "min. 1 element" }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-010",
      "status": "proposed",
      "name": "Evidence",
      "storage": "embedded",
      "description": "Jedna wartość-dowód z jednostką, źródłem i datą danych.",
      "fields": [
        { "name": "label", "type": "string(80)", "required": true, "note": "np. KBW 60 dni" },
        {
          "name": "value",
          "type": "number | string | null",
          "required": true,
          "note": "null = brak danych"
        },
        { "name": "unit", "type": "string(20) | null", "required": true },
        {
          "name": "sourceId",
          "type": "enum(uldk|meteo|sentinel2|eumetsat|soilgrids|elevation|overpass|engine)",
          "required": true,
          "note": "engine = wartość wyliczona z kilku źródeł"
        },
        {
          "name": "dataDate",
          "type": "string(40)",
          "required": true,
          "note": "data lub okres danych, np. 2025-04-01–2025-05-30"
        },
        { "name": "note", "type": "string | null", "required": false }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-011",
      "status": "proposed",
      "name": "SourceStatus",
      "storage": "embedded in DM-001",
      "description": "Status źródła w tej analizie (krok 3 i 7).",
      "fields": [
        {
          "name": "sourceId",
          "type": "enum(uldk|meteo|sentinel2|eumetsat|soilgrids|elevation|overpass)",
          "required": true
        },
        { "name": "name", "type": "string(80)", "required": true },
        { "name": "label", "type": "string(40)", "required": true },
        {
          "name": "category",
          "type": "enum(spatial|meteo|satellite|soil|terrain|hydro)",
          "required": true
        },
        { "name": "provider", "type": "string(80)", "required": true },
        { "name": "url", "type": "string", "required": true },
        { "name": "license", "type": "string(80)", "required": true },
        { "name": "status", "type": "enum(ok|cached|missing|error|timeout)", "required": true },
        {
          "name": "dataPeriod",
          "type": "string(40) | null",
          "required": true,
          "note": "np. 2015-03-08–2025-05-20 albo data sceny 2025-05-14"
        },
        { "name": "fetchedAt", "type": "datetime | null", "required": true },
        { "name": "durationMs", "type": "integer", "required": true },
        {
          "name": "message",
          "type": "string | null",
          "required": true,
          "note": "dla rolnika, np. Brak bezchmurnego zdjęcia od 2025-04-05"
        }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-012",
      "status": "proposed",
      "name": "DataGap",
      "storage": "embedded in DM-001",
      "description": "Jawny brak danych i jego wpływ na wynik.",
      "fields": [
        {
          "name": "sourceId",
          "type": "enum(uldk|meteo|sentinel2|eumetsat|soilgrids|elevation|overpass)",
          "required": true
        },
        {
          "name": "what",
          "type": "string",
          "required": true,
          "note": "np. Brak danych glebowych SoilGrids"
        },
        {
          "name": "impact",
          "type": "string",
          "required": true,
          "note": "np. Nie policzono pojemności wodnej gleby i deficytu glebowego; pewność obniżona"
        }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-013",
      "status": "proposed",
      "name": "WaterBalanceWindow",
      "storage": "embedded in DM-006",
      "description": "KBW = Σ(P − ETc) dla okna n dni kończącego się w dacie analizy, na tle 10 lat (70 próbek, ADR-007 §3).",
      "fields": [
        { "name": "days", "type": "enum(30|60)", "required": true },
        { "name": "from", "type": "string(10)", "required": true },
        { "name": "to", "type": "string(10)", "required": true },
        { "name": "precipitationMm", "type": "number", "required": true },
        { "name": "et0Mm", "type": "number", "required": true },
        { "name": "etcMm", "type": "number", "required": true },
        { "name": "kbwMm", "type": "number", "required": true },
        { "name": "normKbwMm", "type": "number", "required": true, "note": "mediana 10 lat" },
        { "name": "anomalyMm", "type": "number", "required": true },
        { "name": "percentile", "type": "number 0–100", "required": true },
        {
          "name": "precipitationNormPct",
          "type": "number",
          "required": true,
          "note": "opad jako % mediany opadu 10 lat"
        },
        { "name": "meanTmaxC", "type": "number", "required": true },
        { "name": "normTmaxC", "type": "number", "required": true }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-014",
      "status": "proposed",
      "name": "SatelliteObservation",
      "storage": "embedded in DM-006",
      "description": "NDVI/NDMI działki z ostatniej ważnej sceny Sentinel-2 L2A ≤ data analizy, interpretowane dla uprawy i miesiąca.",
      "fields": [
        { "name": "sceneId", "type": "string(80)", "required": true },
        { "name": "sceneDate", "type": "string(10)", "required": true },
        { "name": "ageDays", "type": "integer", "required": true },
        { "name": "validPixelFraction", "type": "number 0–1", "required": true },
        { "name": "validPixels", "type": "integer", "required": true },
        { "name": "ndvi", "type": "number | null", "required": true },
        { "name": "ndmi", "type": "number | null", "required": true },
        { "name": "ndviAssessment", "type": "enum(below|normal|above|unknown)", "required": true },
        { "name": "ndmiAssessment", "type": "enum(below|normal|above|unknown)", "required": true },
        {
          "name": "expected",
          "type": "object { ndviMin: number, ndviMax: number, ndmiMin: number, ndmiMax: number }",
          "required": true
        },
        {
          "name": "thumbnailUrl",
          "type": "string | null",
          "required": false,
          "note": "should: asset thumbnail z STAC"
        }
      ],
      "relations": [],
      "indexes": []
    },
    {
      "id": "DM-015",
      "status": "proposed",
      "name": "SatelliteSoilMoisture",
      "storage": "embedded in DM-006",
      "description": "Wilgotność powierzchniowej warstwy gleby z ASCAT (EUMETSAT Data Store / H SAF), najnowsza obserwacja w oknie D−3…D dla centroidu działki. Wartość orientacyjna, nie zmienia klasy suszy (ADR-006, ADR-007 §5a).",
      "fields": [
        {
          "name": "valuePct",
          "type": "number 0–100",
          "required": true,
          "note": "% saturacji (degree of saturation)"
        },
        { "name": "assessment", "type": "enum(dry|normal|wet|unknown)", "required": true },
