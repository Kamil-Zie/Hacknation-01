{
  "name": "kropla",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "database"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/backend\" \"npm run dev -w apps/frontend\"",
    "build": "npm run build -w apps/backend && npm run build -w apps/frontend",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w apps/backend && npm run typecheck -w apps/frontend && npm run typecheck -w database",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed -w database",
    "warm-cache": "npm run warm-cache -w database --",
    "demo-accounts": "npm run demo-accounts -w database --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
